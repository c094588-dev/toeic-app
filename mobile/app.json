{
  "expo": {
    "name": "英単語ノート",
    "slug": "toeic-word-note",
    "owner": "soruy",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.eitangonote.app",
      "supportsTablet": false,
      "config": { "usesNonExemptEncryption": false },
      "infoPlist": { "CFBundleDevelopmentRegion": "ja" }
    },
    "android": {},
    "locales": { "ja": "./locales/ja.json" },
    "web": { "bundler": "metro" },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#F5F6F2",
          "dark": { "image": "./assets/splash-icon.png", "backgroundColor": "#111B22" }
        }
      ]
    ],
    "extra": {
      "eas": { "projectId": "610f1679-02c0-4cb4-89e3-20860c72eecd" }
    }
  }
}
